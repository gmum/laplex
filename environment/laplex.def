Bootstrap: docker
From: nvidia/cuda:13.2.1-devel-ubuntu24.04

# The software of the paper's runs, limited to what this repository uses.  Versions are
# those of the container image the paper's runs used:
# Ubuntu 24.04, CUDA 13.2 with nvcc and gcc 13.3, TeX Live 2023, Python 3.14.6,
# torch 2.13.0+cu132, and requirements.txt.  Build from this directory (the %files source
# is relative to it):
#
#   cd environment
#   apptainer build laplex.sif laplex.def    # or: singularity build --fakeroot (or sudo)
#   then set LAPLEX_SIF=$PWD/laplex.sif in ../.env (read by the */sif.sh wrappers)
#
# CUDA 13 needs an NVIDIA driver >= 580 on the host (see nvidia-smi).  For an older
# driver use environment.yml (CUDA 12.6) instead.

%files
    requirements.txt /opt/laplex/requirements.txt

%environment
    export PATH=/opt/laplex/venv/bin:$PATH
    export CUDA_HOME=/usr/local/cuda
    # The image is read-only: keep ~/.local out of its Python, caches on writable paths.
    export PYTHONNOUSERSITE=1
    export MPLCONFIGDIR="${TMPDIR:-/tmp}/matplotlib"

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    # git: the benchmarks record the repository revision.  TeX Live: figures typeset with
    # the paper's fonts (pdflatex, pgf, Times/Helvetica).
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates curl git \
        texlive-latex-extra texlive-fonts-recommended cm-super
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Python and packages installed with uv, as in the paper's image.
    export UV_INSTALL_DIR=/opt/laplex/bin UV_PYTHON_INSTALL_DIR=/opt/laplex/python UV_CACHE_DIR=/tmp/uv-cache
    curl -LsSf https://astral.sh/uv/0.12.1/install.sh | sh
    /opt/laplex/bin/uv venv /opt/laplex/venv --python 3.14.6
    # The last three are the CUDA packages torch does not pin exactly.
    /opt/laplex/bin/uv pip install --python /opt/laplex/venv/bin/python \
        --extra-index-url https://download.pytorch.org/whl/cu132 --index-strategy unsafe-best-match \
        -r /opt/laplex/requirements.txt \
        torch==2.13.0+cu132 torchvision==0.28.0+cu132 \
        cuda-bindings==13.0.3 cuda-pathfinder==1.2.2 nvidia-nvjitlink==13.2.78
    rm -rf /tmp/uv-cache

%test
    /opt/laplex/venv/bin/python -c "import torch, torchvision, numpy, scipy, pandas, sklearn, matplotlib; print('torch', torch.__version__, 'CUDA', torch.version.cuda)"
    nvcc --version | tail -1
    pdflatex --version | head -1
