# Machine-specific settings.  Copy this file to .env (not tracked by git) and fill in what
# applies to your machine:
#
#   cp .env.example .env
#
# The run wrappers (benchmarks/sif.sh, nn_training/sif.sh, log_likelihood/sif.sh) and the run
# scripts read .env automatically.  To use it in your own shell (e.g. before sbatch), export it:
#
#   set -a; source .env; set +a
#
# Every setting is optional: a commented-out line keeps the default given next to it.

# --- Software environment ---------------------------------------------------------------------
# Apptainer/Singularity image built from environment/laplex.def.  Unset or empty: the commands
# run in the current Python environment (e.g. the conda environment of environment/environment.yml).
# LAPLEX_SIF=/path/to/laplex.sif

# Extra host directories to make visible inside the container, separated by ':'.
# The dataset directories below are bound automatically (read-only) when they are set.
# LAPLEX_BIND=/path/to/scratch

# --- Datasets ---------------------------------------------------------------------------------
# Full ImageNet (ILSVRC 2012, CLS-LOC): train/<synset>/ and a flat val/ folder, plus the
# validation labels LOC_val_solution.csv.  nn_training/make_imagenet10.py builds ImageNet-10
# (and, with --all-classes, a per-class ImageNet) from them as symlinks.
# IMAGENET_ROOT=/path/to/imagenet/CLS-LOC
# IMAGENET_VAL_CSV=/path/to/LOC_val_solution.csv

# ImageNet-10 root used by the projection, attention and density experiments.
# Default: nn_training/data/imagenet10 (created by make_imagenet10.py).
# IMNET=/path/to/imagenet10

# ImageNet (train/<synset>/, val/<synset>/) for the classification heads (App. H).
# Default: the paths in nn_training/classification_heads/configs/*.py.
# DATA_ROOT=/path/to/imagenet
# VAL_ROOT=/path/to/imagenet/val

# torchvision datasets (MNIST, cifar10/, SVHN/) for App. J.  Default: nn_training/data/torchvision.
# TV_DATA=/path/to/torchvision

# DIV2K high-resolution images (DIV2K_train_HR/, DIV2K_valid_HR/).  Default: data/div2k.
# DIV2K_ROOT=/path/to/div2k

# ImageNette-320 (train/, val/).  Default: data/imagenette2-320.
# IMAGENETTE_ROOT=/path/to/imagenette2-320

# --- Slurm ------------------------------------------------------------------------------------
# sbatch reads these variables itself (they override the #SBATCH lines of the scripts, and
# options on the sbatch command line override them).  The sbatch files only request resources
# (GPUs, CPUs, memory, time); choose the partition / QOS / account of your cluster here, or
# per job with  sbatch -p <partition> -q <qos> ...
# SBATCH_PARTITION=gpu
# SBATCH_QOS=normal
# SBATCH_ACCOUNT=my-account
